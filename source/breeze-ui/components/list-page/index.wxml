<scroll-view
  scroll-y
  class="bz-list-page {{customClass || ''}}"
  style="height: {{height}};"
  refresher-enabled="{{refresherEnabled}}"
  refresher-triggered="{{refreshing}}"
  lower-threshold="{{lowerThreshold}}"
  bindrefresherrefresh="onRefresh"
  bindscrolltolower="onLoadMore"
>
  <bz-state-box
    loading="{{loading}}"
    skeleton="{{skeleton}}"
    empty="{{empty}}"
    error="{{error}}"
    empty-text="{{emptyText}}"
    error-text="{{errorText}}"
    loading-text="{{loadingText}}"
    skeleton-template="{{skeletonTemplate}}"
    skeleton-rows="{{skeletonRows}}"
    retry="{{retry}}"
    min-height="{{minHeight}}"
    bind:retry="onRetry"
  >
    <slot />
  </bz-state-box>

  <view
    wx:if="{{showLoadmore && viewState === 'content' && (loadmoreStatus || loadmoreText)}}"
    class="bz-list-page__footer"
  >
    <view wx:if="{{loadmoreStatus === 'loading'}}" class="bz-load loading"></view>
    <view wx:elif="{{loadmoreStatus === 'over'}}" class="bz-load over"></view>
    <view wx:elif="{{loadmoreStatus === 'erro'}}" class="bz-load erro"></view>
    <bz-loadmore wx:elif="{{loadmoreText}}" text="{{loadmoreText}}" />
  </view>
</scroll-view>
