<block wx:if="{{type == 'case'}}">
  <view class="{{column == 2 ? 'double-column' : ''}} {{customClass || ''}}" bindtap="onTap">
    <view class="bz-card case {{isCard ? 'no-card' : ''}}" wx:for="{{_data}}" wx:key="name">
      <block wx:if="{{item.loading}}">
        <bz-skeleton template="case" loading="{{true}}" />
      </block>
      <block wx:else>
        <view class="bz-item shadow">
          <view class="image">
            <image src="{{item.image}}" mode="{{mode}}"></image>
            <bz-tag bgColor="{{item.tagColor}}" light="{{item.light}}">{{item.tagName}}</bz-tag>
            <view class="bz-bar bg-shadeBottom">
              <text class="text-cut">{{item.title}}</text>
            </view>
          </view>
          <view class="bz-card-case-footer">
            <image class="bz-card-case-footer__avatar" src="{{item.avatar}}" mode="aspectFill" />
            <view class="bz-card-case-footer__info">
              <view class="bz-card-case-footer__name text-grey">{{item.name}}</view>
              <view class="bz-card-case-footer__meta text-gray text-sm">{{item.time}}</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
</block>
<block wx:if="{{type == 'dynamic'}}">
  <view class="bz-card dynamic {{isCard?'no-card':''}}" wx:for="{{_data}}">
    <view class="bz-item shadow">
      <view class="bz-list menu-avatar">
        <view class="bz-item">
          <view class="bz-avatar round lg" style="background-image:url({{item.avatar}});"></view>
          <view class="content flex-sub">
            <view>{{item.name}}</view>
            <view class="text-gray text-sm flex justify-between">
              {{item.time}}
            </view>
          </view>
        </view>
      </view>
      <view class="text-content">
        {{item.content}}
      </view>
      <view class="grid flex-sub padding-lr {{isCard?'col-3 grid-square':'col-1'}}">
        <view class="bg-img {{isCard?'':'only-img'}}" style="background-image:url({{item.avatar}});">
        </view>
      </view>
      <view class="text-gray text-sm text-right padding">
        <block wx:for="{{item.tags}}" wx:for-item="child">
          <bz-icon name="{{child.name}}" extraClass="margin-lr-xs"></bz-icon>
          {{child.num}}
        </block>
      </view>
      <view class="bz-list menu-avatar comment solids-top" wx:for="{{item.message}}" wx:for-item="child">
        <view class="bz-item">
          <view class="bz-avatar round" style="background-image:url({{child.avatar}});"></view>
          <view class="content">
            <view class="text-grey">{{child.name}}</view>
            <view class="text-gray text-content text-df">
              {{child.comment}}
            </view>
            <view class="bg-grey padding-sm radius margin-top-sm  text-sm">
              <view class="flex">
                <view>{{child.replyName}}：</view>
                <view class="flex-sub">{{child.reply}}</view>
              </view>
            </view>
            <view class="margin-top-sm flex justify-between">
              <view class="text-gray text-df">{{child.time}}</view>
              <view>
                <block wx:for="{{child.tags}}" wx:for-item="childs">
                  <bz-icon name="{{childs.name}}" textColor="gray" extraClass="margin-lr-xs"></bz-icon>
                  {{childs.num}}
                </block>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</block>
<block wx:if="{{type == 'article'}}">
  <view class="bz-card-article-list {{customClass || ''}}">
    <view class="bz-card article {{isCard ? 'no-card' : ''}}" wx:for="{{_data}}" wx:key="index">
      <block wx:if="{{item.loading}}">
        <bz-skeleton template="article" loading="{{true}}" />
      </block>
      <block wx:else>
        <view class="bz-item shadow">
          <view class="title">
            <view class="text-cut">{{item.title}}</view>
          </view>
          <view class="content">
            <image src="{{item.image}}" mode="aspectFill"></image>
            <view class="desc">
              <view class="text-content">{{item.content}}</view>
              <view>
                <bz-tag
                  bgColor="{{child.bgColor}}"
                  round
                  sm
                  light
                  wx:for="{{item.tags}}"
                  wx:for-item="child"
                >{{child.name}}</bz-tag>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
</block>
