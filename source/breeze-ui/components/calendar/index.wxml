<view class="container {{customClass || ''}}">
  <view class="bz-calendar__header radius text-center">
    <view bindtap="last">上一月</view>
    <view class="bz-calendar__date text-lg">{{year}}年{{month}}月{{today}}日</view>
    <view bindtap="next">下一月</view>
  </view>
  <view class="main">
    <view class="main-title">
      <view>SUN</view>
      <view>MON</view>
      <view>TUE</view>
      <view>WED</view>
      <view>THU</view>
      <view>FRI</view>
      <view>SAT</view>
    </view>
    <view class="main-center">
      <view wx:for="{{space}}" wx:key="*this"></view>
      <view
        wx:for="{{day}}"
        wx:key="*this"
        data-today="{{item}}"
        bindtap="click"
        class="bz-calendar__day {{today == item ? 'bz-calendar__day--active' : ''}}"
      >
        {{item}}
      </view>
    </view>
  </view>
</view>
