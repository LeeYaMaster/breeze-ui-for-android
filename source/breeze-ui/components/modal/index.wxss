/* bz-modal 组件样式（源文件） */

.bz-modal {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 1110;
	opacity: 0;
	outline: 0;
	text-align: center;
	-ms-transform: scale(1.185);
	transform: scale(1.185);
	backface-visibility: hidden;
	perspective: 2000rpx;
	background: rgba(0, 0, 0, 0.6);
	transition: all 0.3s ease-in-out 0s;
	pointer-events: none;
}

.bz-modal::before {
	content: "\200B";
	display: inline-block;
	height: 100%;
	vertical-align: middle;
}

.bz-modal.show {
	opacity: 1;
	transition-duration: 0.3s;
	-ms-transform: scale(1);
	transform: scale(1);
	overflow-x: hidden;
	overflow-y: auto;
	pointer-events: auto;
}

.bz-dialog {
	position: relative;
	display: inline-block;
	vertical-align: middle;
	margin-left: auto;
	margin-right: auto;
	width: 680rpx;
	max-width: 100%;
	background-color: #f8f8f8;
	border-radius: 10rpx;
	overflow: hidden;
}

.bz-modal.bottom-modal::before {
	vertical-align: bottom;
}

.bz-modal.bottom-modal .bz-dialog {
	width: 100%;
	border-radius: 0;
}

.bz-modal.bottom-modal {
	margin-bottom: -1000rpx;
}

.bz-modal.bottom-modal.show {
	margin-bottom: 0;
}

.bz-modal.drawer-modal {
	transform: scale(1);
	display: flex;
}

.bz-modal.drawer-modal .bz-dialog {
	height: 100%;
	min-width: 200rpx;
	border-radius: 0;
	margin: initial;
	transition-duration: 0.3s;
}

.bz-modal.drawer-modal.justify-start .bz-dialog {
	transform: translateX(-100%);
}

.bz-modal.drawer-modal.justify-end .bz-dialog {
	transform: translateX(100%);
}

.bz-modal.drawer-modal.show .bz-dialog {
	transform: translateX(0%);
}

.bz-modal .bz-dialog>.bz-bar:first-child .action {
	min-width: 100rpx;
	margin-right: 0;
	min-height: 100rpx;
}
