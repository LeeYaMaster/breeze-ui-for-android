<view class="bz-chat {{customClass || ''}}" bindtap="onTap">
  <block wx:for="{{items}}" wx:key="id">
    <view wx:if="{{item.type === 'info'}}" class="bz-info {{item.infoClass || ''}}">
      <text wx:if="{{item.icon}}" class="{{item.icon}}"></text>
      {{item.text}}
      <text wx:if="{{item.linkText}}" class="text-blue">{{item.linkText}}</text>
    </view>

    <view
      wx:else
      id="{{item.anchorId || ('msg-' + item.id)}}"
      class="bz-item {{item.role === 'self' ? 'self' : ''}}"
    >
      <view
        wx:if="{{item.role !== 'self'}}"
        class="bz-avatar radius"
        style="background-image:url({{item.avatar || peerAvatar}});"
      ></view>

      <view class="main">
        <image
          wx:if="{{item.type === 'image'}}"
          src="{{item.image}}"
          class="radius"
          mode="widthFix"
        ></image>

        <view wx:elif="{{item.type === 'voice'}}" class="content shadow {{item.role === 'self' ? 'bg-green' : ''}}">
          <text class="bzIcon-sound text-xxl padding-right-xl"></text>
          <text>{{item.text}}</text>
        </view>

        <view wx:elif="{{item.type === 'location'}}">
          <view class="action">
            <text class="bzIcon-locationfill text-orange text-xxl"></text>
          </view>
          <view class="content shadow {{item.role === 'self' ? 'bg-green' : ''}}">
            {{item.text}}
          </view>
        </view>

        <block wx:else>
          <view
            wx:if="{{item.actionText}}"
            class="action {{item.actionClass || 'text-bold text-grey'}}"
          >
            {{item.actionText}}
          </view>
          <view class="content shadow {{item.role === 'self' ? 'bg-green' : ''}}">
            <text>{{item.text}}</text>
          </view>
          <view wx:if="{{item.hintIcon}}" class="action text-grey">
            <text class="{{item.hintIcon}} text-red text-xxl"></text>
            <text wx:if="{{item.hintText}}" class="text-sm margin-left-sm">{{item.hintText}}</text>
          </view>
        </block>
      </view>

      <view
        wx:if="{{item.role === 'self'}}"
        class="bz-avatar radius"
        style="background-image:url({{item.avatar || selfAvatar}});"
      ></view>

      <view wx:if="{{item.time}}" class="date">{{item.time}}</view>
    </view>
  </block>

  <slot name="footer"></slot>
</view>
