
<block wx:if="{{isScroll}}">
  <scroll-view scroll-x class="bg-white padding response bz-steps steps-bottom {{customClass||''}}" scroll-into-view="scroll-{{scroll}}" scroll-with-animation bindtap="onTap">
  <view class="bz-item {{index>scroll?'':'text-blue'}} padding-lr-xl" wx:for="{{10}}" wx:key id="scroll-{{index}}">
   Level {{index + 1}} <text class="num" data-index="{{index + 1}}"></text>
  </view>
</scroll-view>
</block>
<block wx:else>
  <view class="bg-white padding {{customClass||''}}">
  <view class="bz-steps {{arrow ?'steps-arrow': ''}}">
    <view class="bz-item {{index>basics?'':textColor}}" wx:for="{{data}}" wx:key>
      <text class="num" wx:if="{{num}}" data-index="{{index + 1}}"></text> 
      <text class="{{item.icon?'bzIcon-'+item.icon:''}}" wx:else></text>
      {{item.name}}
    </view>
  </view>
</view>
</block>
