/* 共享：列表 .bz-list（list-menu / list-grid / list-message 等共用） */

.grayscale {
	filter: grayscale(1);
}

.bz-list+.bz-list {
	margin-top: 30rpx
}

.bz-list>.bz-item {
	transition: all .6s ease-in-out 0s;
	transform: translateX(0rpx)
}

.bz-list>.bz-item.move-cur {
	transform: translateX(-260rpx)
}

.bz-list>.bz-item .move {
	position: absolute;
	right: 0;
	display: flex;
	width: 260rpx;
	height: 100%;
	transform: translateX(100%)
}

.bz-list>.bz-item .move view {
	display: flex;
	flex: 1;
	justify-content: center;
	align-items: center
}

.bz-list.menu-avatar {
	overflow: hidden;
}

.bz-list.menu-avatar>.bz-item {
	position: relative;
	display: flex;
	padding-right: 10rpx;
	height: 140rpx;
	background-color: var(--white);
	justify-content: flex-end;
	align-items: center
}

.bz-list.menu-avatar>.bz-item>.bz-avatar {
	position: absolute;
	left: 30rpx
}

.bz-list.menu-avatar>.bz-item .flex .text-cut {
	max-width: 510rpx
}

.bz-list.menu-avatar>.bz-item .content {
	position: absolute;
	left: 146rpx;
	width: calc(100% - 96rpx - 60rpx - 120rpx - 20rpx);
	line-height: 1.6em;
}

.bz-list.menu-avatar>.bz-item .content.flex-sub {
	width: calc(100% - 96rpx - 60rpx - 20rpx);
}

.bz-list.menu-avatar>.bz-item .content>view:first-child {
	font-size: var(--bz-font-size-md, 30rpx);
	display: flex;
	align-items: center
}

.bz-list.menu-avatar>.bz-item .content .bz-tag.sm {
	display: inline-block;
	margin-left: 10rpx;
	height: 28rpx;
	font-size: 16rpx;
	line-height: 32rpx
}

.bz-list.menu-avatar>.bz-item .action {
	width: 100rpx;
	text-align: center
}

.bz-list.menu-avatar>.bz-item .action view+view {
	margin-top: 10rpx
}

.bz-list.menu-avatar.comment>.bz-item .content {
	position: relative;
	left: 0;
	width: auto;
	flex: 1;
}

.bz-list.menu-avatar.comment>.bz-item {
	padding: 30rpx 30rpx 30rpx 120rpx;
	height: auto
}

.bz-list.menu-avatar.comment .bz-avatar {
	align-self: flex-start
}

.bz-list.menu>.bz-item {
	position: relative;
	display: flex;
	padding: 0 30rpx;
	min-height: 100rpx;
	background-color: var(--white);
	justify-content: space-between;
	align-items: center
}

.bz-list.menu>.bz-item:last-child:after {
	border: none
}

.bz-list.menu>.bz-item:after {
	position: absolute;
	top: 0;
	left: 0;
	box-sizing: border-box;
	width: 200%;
	height: 200%;
	border-bottom: 1rpx solid #ddd;
	border-radius: inherit;
	content: " ";
	transform: scale(.5);
	transform-origin: 0 0;
	pointer-events: none
}

.bz-list.menu>.bz-item.grayscale {
	background-color: #f5f5f5
}

.bz-list.menu>.bz-item.cur {
	background-color: #fcf7e9
}

.bz-list.menu>.bz-item.arrow {
	padding-right: 90rpx
}

.bz-list.menu>.bz-item.arrow:before {
	position: absolute;
	top: 0;
	right: 30rpx;
	bottom: 0;
	display: block;
	margin: auto;
	width: 30rpx;
	height: 30rpx;
	color: var(--grey);
	content: "\e6a3";
	text-align: center;
	font-size: 34rpx;
	font-family: "bzIcon";
	line-height: 30rpx
}

.bz-list.menu>.bz-item button.content {
	padding: 0;
	background-color: transparent;
	justify-content: flex-start
}

.bz-list.menu>.bz-item button.content:after {
	display: none
}

.bz-list.menu>.bz-item .bz-avatar-group .bz-avatar {
	border-color: var(--white)
}

.bz-list.menu>.bz-item .content>view:first-child {
	display: flex;
	align-items: center
}

.bz-list.menu>.bz-item .content>text[class*=bzIcon] {
	display: inline-block;
	margin-right: 10rpx;
	width: 1.6em;
	text-align: center
}

.bz-list.menu>.bz-item .content>image {
	display: inline-block;
	margin-right: 10rpx;
	width: 1.6em;
	height: 1.6em;
	vertical-align: middle
}

.bz-list.menu>.bz-item .content {
	font-size: var(--bz-font-size-md, 30rpx);
	line-height: 1.6em;
	flex: 1
}

.bz-list.menu>.bz-item .content .bz-tag.sm {
	display: inline-block;
	margin-left: 10rpx;
	height: 28rpx;
	font-size: 16rpx;
	line-height: 32rpx
}

.bz-list.menu>.bz-item .action .bz-tag:empty {
	right: 10rpx
}

.bz-list.menu {
	display: block;
	overflow: hidden
}

.bz-list.menu.sm-border>.bz-item:after {
	left: 30rpx;
	width: calc(200% - 120rpx)
}

.bz-list.grid>.bz-item {
	position: relative;
	display: flex;
	padding: 20rpx 0 30rpx;
	transition-duration: 0s;
	flex-direction: column
}

.bz-list.grid>.bz-item:after {
	position: absolute;
	top: 0;
	left: 0;
	box-sizing: border-box;
	width: 200%;
	height: 200%;
	border-right: 1px solid rgba(0, 0, 0, .1);
	border-bottom: 1px solid rgba(0, 0, 0, .1);
	border-radius: inherit;
	content: " ";
	transform: scale(.5);
	transform-origin: 0 0;
	pointer-events: none
}

.bz-list.grid>.bz-item text {
	display: block;
	margin-top: 10rpx;
	color: #888;
	font-size: 26rpx;
	line-height: 40rpx
}

.bz-list.grid>.bz-item [class*=bzIcon] {
	position: relative;
	display: block;
	margin-top: 20rpx;
	width: 100%;
	font-size: 48rpx
}

.bz-list.grid>.bz-item .bz-tag {
	right: auto;
	left: 50%;
	margin-left: 20rpx
}

.bz-list.grid {
	background-color: var(--white);
	text-align: center
}

.bz-list.grid.no-border>.bz-item {
	padding-top: 10rpx;
	padding-bottom: 20rpx
}

.bz-list.grid.no-border>.bz-item:after {
	border: none
}

.bz-list.grid.no-border {
	padding: 20rpx 10rpx
}

.bz-list.grid.col-3>.bz-item:nth-child(3n):after,
.bz-list.grid.col-4>.bz-item:nth-child(4n):after,
.bz-list.grid.col-5>.bz-item:nth-child(5n):after {
	border-right-width: 0
}

.bz-list.card-menu {
	overflow: hidden;
	margin-right: 30rpx;
	margin-left: 30rpx;
	border-radius: var(--bz-radius-xl, 20rpx)
}
